OPENROUTER_API_KEY=REEMPLAZA_CON_TU_KEY_OPENROUTER
# Login con Google (Credential Manager). Crea un OAuth Web client en Google Cloud
# Console → APIs y servicios → Credenciales, y pega aquí su ID de cliente.
# Sin este valor, el botón de Google se oculta solo.
GOOGLE_WEB_CLIENT_ID=REEMPLAZA_CON_TU_GOOGLE_WEB_CLIENT_ID
